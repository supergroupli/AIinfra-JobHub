{
  "apiVersion": "v1",
  "kind": "List",
  "items": [
    {
      "apiVersion": "v1",
      "kind": "ConfigMap",
      "metadata": {
        "name": "jobhub-page"
      },
      "data": {
        "index.html": "<h1>AI Infra JobHub teaching service</h1><p>This is not a model server.</p>"
      }
    },
    {
      "apiVersion": "apps/v1",
      "kind": "Deployment",
      "metadata": {
        "name": "jobhub-demo"
      },
      "spec": {
        "replicas": 2,
        "selector": {
          "matchLabels": {
            "app": "jobhub-demo"
          }
        },
        "strategy": {
          "type": "RollingUpdate",
          "rollingUpdate": {
            "maxSurge": 1,
            "maxUnavailable": 0
          }
        },
        "template": {
          "metadata": {
            "labels": {
              "app": "jobhub-demo"
            }
          },
          "spec": {
            "containers": [
              {
                "name": "demo",
                "image": "nginx:1.27.5",
                "ports": [
                  {
                    "containerPort": 80
                  }
                ],
                "resources": {
                  "requests": {
                    "cpu": "100m",
                    "memory": "64Mi"
                  },
                  "limits": {
                    "cpu": "500m",
                    "memory": "128Mi"
                  }
                },
                "volumeMounts": [
                  {
                    "name": "page",
                    "mountPath": "/usr/share/nginx/html",
                    "readOnly": true
                  }
                ],
                "startupProbe": {
                  "httpGet": {
                    "path": "/",
                    "port": 80
                  },
                  "failureThreshold": 30,
                  "periodSeconds": 2
                },
                "readinessProbe": {
                  "httpGet": {
                    "path": "/",
                    "port": 80
                  },
                  "periodSeconds": 5
                },
                "livenessProbe": {
                  "httpGet": {
                    "path": "/",
                    "port": 80
                  },
                  "periodSeconds": 10
                }
              }
            ],
            "volumes": [
              {
                "name": "page",
                "configMap": {
                  "name": "jobhub-page"
                }
              }
            ]
          }
        }
      }
    },
    {
      "apiVersion": "v1",
      "kind": "Service",
      "metadata": {
        "name": "jobhub-demo"
      },
      "spec": {
        "type": "ClusterIP",
        "selector": {
          "app": "jobhub-demo"
        },
        "ports": [
          {
            "port": 8080,
            "targetPort": 80
          }
        ]
      }
    }
  ]
}
